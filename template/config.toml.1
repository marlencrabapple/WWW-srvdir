[global]
 charset = 'UTF-8'
 enable-ssl = 1

 #ssl.certbundle = "<: $ssl.certbundle :>"
 #ssl.keyfile = "<: $ssl.keyfile :>"
 ssl = { bundleundle = "<: $ssl.certbundle :>", keyfile = "<: $keyfile :>"}


[path.example]
 listen = ':1234' # Optional, can be set globally
 mount = '/'
 root = 'public'

[path.another]
 listen = "run/psgi.sock"
 mount = "/another"
 root = "/"
 userdb = [
   { name = "noname", crypt = "$argon2id..." },
   { name = "nameless", crypt = "$argon2id..." }
 ] # this overrides the top level userdb property

[path.cgiapp]
 mount ="/asdf/fdsa"
 root ="/usr/share/cgit/cgit.cgi"

[[userdb]]
 name = "nanashi"
 crypt = "$argon2id$v=19$m=65536,t=3,p=16$$OOYQn4XpCNL8+/z4KgtmmaHx1xc1FJ51dU79ExEdeEA"

[[userdb]]
 name = "anonymous"
 password = "cleartext" # original value will be replaced with hash and will need to be retrieved from generated backup file if not recorded elsewhere
